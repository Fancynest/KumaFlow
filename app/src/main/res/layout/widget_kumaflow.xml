<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total Balance"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_widget_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Rp 0"
        android:textColor="@color/widget_text_primary"
        android:textSize="32sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_bg"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView android:id="@+id/tv_w1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cash" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
            <TextView android:id="@+id/tv_w1_bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rp 0" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_bg"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView android:id="@+id/tv_w2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blu" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
            <TextView android:id="@+id/tv_w2_bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rp 0" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_wallet_bg"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView android:id="@+id/tv_w3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gopay" android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
            <TextView android:id="@+id/tv_w3_bal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rp 0" android:textColor="@color/widget_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_widget_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↑ Income Rp 0"
            android:textColor="#66BB6A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_widget_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="↓ Expenses Rp 0"
            android:textColor="#EF5350"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>
</LinearLayout>